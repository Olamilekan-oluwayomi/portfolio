{
  "name": "annotated-portfolio",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-content.ts && next build --webpack && node scripts/check-budgets.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:content": "tsx scripts/check-content.ts",
    "test:launch": "playwright test",
    "audit:performance": "node scripts/audit-performance.mjs",
    "check:launch-content": "tsx scripts/check-launch-content.ts",
    "deploy:production": "vercel deploy --prod --yes && vercel alias set portfolio-omega-snowy-medsu1hh4w.vercel.app lizzle.vercel.app",
    "prepare:brand": "tsx scripts/prepare-brand-assets.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.8",
    "gray-matter": "4.0.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-vitals": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "10.12.0",
    "lighthouse": "^13.5.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
