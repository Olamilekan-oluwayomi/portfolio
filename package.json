{
  "name": "annotated-portfolio",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-content.ts && next build && node scripts/check-budgets.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:content": "tsx scripts/check-content.ts",
    "check:performance": "lhci autorun"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.8",
    "gray-matter": "4.0.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@lhci/cli": {
      "tmp": "0.2.7",
      "uuid": "11.1.1",
      "basic-ftp": "6.2.2",
      "lighthouse": "13.5.0"
    }
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
